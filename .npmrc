# 固定镜像源：package-lock.json 里的 resolved 指向 npmmirror。
# 若运行时 registry 与 lock 不一致，npm 的 arborist 会认为本地树失效，
# 并在 `npm exec` / `npx` 触发的 reify 过程中剪掉依赖（本项目实际发生过一次）。
registry=https://registry.npmmirror.com
audit=false
fund=false

# 约定：自检一律直调二进制，不要用 npx / npm exec（它会重新解析并可能改动 node_modules）
#   类型检查  node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json
#   单元测试  node node_modules/vitest/vitest.mjs run
#   代码检查  node node_modules/eslint/bin/eslint.js . --ext .ts,.tsx --max-warnings=0
#   生产构建  node node_modules/electron-vite/bin/electron-vite.js build
